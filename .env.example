# Copy this file to .env and replace the placeholder values.
# .env is gitignored; never commit real values. Full list of settings: fluxapp/settings.py

# --- MySQL container (read by the dev container's `db` service) ---
MYSQL_DATABASE=fluxapp
MYSQL_USER=flux
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Django (required) ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Must match the MYSQL_* values above; `db` is the database container's host name.
DATABASE_URL=mysql://flux:change-me@db:3306/fluxapp

# --- Optional ---
# SELECT-only user for the SQL Explorer console (leave empty in development).
READONLY_DATABASE_URL=

# Email. The console backend prints mail to the terminal instead of sending it.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CONTACT_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=GRAND Explorer <no-reply@example.com>
# For real SMTP sending, also set:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Upload workbench: manuscript pre-fill uses the Anthropic API (off by default).
WORKBENCH_LLM_ENABLED=False
WORKBENCH_LLM_DAILY_CAP=10
# ANTHROPIC_API_KEY=
# Abstract lookup by DOI (off by default).
WORKBENCH_ENRICH_ENABLED=False
