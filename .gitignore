# --- Secrets / environment ---
.env
DEPLOY_REVIEW.md

# --- Python ---
__pycache__/
*.pyc
# Local, disposable test virtualenv (rebuild with: python3 -m venv .test-venv)
.test-venv/

# --- Django ---
db.sqlite3
media/
staticfiles/

# --- Dev artifacts (should never be in the repo) ---
debug_log.txt

# --- MySQL data directory ---
# Bind-mounted into the `db` devcontainer service; holds the live database,
# auto-generated SSL keys (*.pem), and binlogs. Must never be versioned.
.devcontainer/db_data/

# --- ETL: large inputs & run-specific artifacts ---
# RawData.csv is the 82 MB denormalized export consumed by import_rawdata.
ETL/RawData.csv
# Undo manifests written by load_tables / apply_enrichment (keep locally for
# rollback, but they are run-specific and shouldn't be committed).
ETL/*_manifest_*.json
# Per-site SoilGrids/NASA POWER response cache (re-derivable from build_soil.py).
ETL/_grid_cache.json

# LibreOffice lock files
.~lock.*#

# Local/editor files (untracked 2026-10-16)
.idea/
.claude/settings.local.json
feature_importance.png
hot_moments_dry_run.csv
