{
	"name": "Django Mysql",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/fluxapp",
    "forwardPorts": [8001],

    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },

	"customizations": {
		"vscode": {
		"extensions": [
			"ms-python.python",
			"batisteo.vscode-django",
			"mtxr.sqltools",
            "mtxr.sqltools-driver-mysql"
		]
		}
	},
    "remoteUser": "root"
}
