{
	"name": "Django Mysql",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/fluxapp",
    "forwardPorts": [8001],

	"customizations": {
		"vscode": {
		"extensions": [
			"ms-python.python",
			"batisteo.vscode-django",
			"mtxr.sqltools",
            "mtxr.sqltools-driver-mysql"
		]
		}
	},
    "remoteUser": "root"
}